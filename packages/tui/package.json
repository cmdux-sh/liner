{
  "name": "linersh",
  "version": "1.0.1",
  "description": "Liner — npm shim, Go TUI launcher, and headless methodology runner.",
  "type": "module",
  "license": "MIT",
  "author": "cmdux-sh",
  "homepage": "https://liner.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdux-sh/liner.git"
  },
  "bugs": {
    "url": "https://github.com/cmdux-sh/liner/issues"
  },
  "bin": {
    "liner": "bin/liner.js"
  },
  "files": [
    "bin/liner.js",
    "dist/",
    "cli-update-docs/"
  ],
  "scripts": {
    "build": "tsc",
    "build:go": "cd ../go-tui && go build -o ../tui/bin/liner-tui ./cmd/liner-tui",
    "build:package": "npm run build && npm run build:go",
    "acceptance:go": "node scripts/go-tui-acceptance.mjs",
    "predev:go": "node scripts/unhide-venv.mjs && npm run build:go",
    "dev:go": "node bin/liner.js",
    "prepack": "node scripts/copy-skill-bundle.mjs && npm run build:package",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:package",
    "predev": "node scripts/unhide-venv.mjs && npm run build:go",
    "dev": "node bin/liner.js",
    "predev:built": "node scripts/unhide-venv.mjs",
    "dev:built": "npm run build:package && node bin/liner.js",
    "start": "node bin/liner.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "optionalDependencies": {
    "linersh-darwin-arm64": "^0.5.7 || ^1.0.0",
    "linersh-darwin-x64": "^0.5.7 || ^1.0.0",
    "linersh-linux-arm64": "^0.5.7 || ^1.0.0",
    "linersh-linux-x64": "^0.5.7 || ^1.0.0",
    "linersh-win32-x64": "^0.5.7 || ^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18"
  }
}
