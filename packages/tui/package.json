{
  "name": "linersh",
  "version": "1.2.0",
  "description": "Liner — npm launcher for the terminal navigator and Core CLI.",
  "type": "module",
  "license": "MIT",
  "author": "cmdux-sh",
  "homepage": "https://liner.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdux-sh/liner.git"
  },
  "bugs": {
    "url": "https://github.com/cmdux-sh/liner/issues"
  },
  "bin": {
    "liner": "bin/liner.js"
  },
  "files": [
    "bin/liner.js"
  ],
  "scripts": {
    "build": "tsc",
    "build:go": "node scripts/build-go-tui.mjs",
    "build:package": "npm run build && npm run build:go",
    "acceptance:go": "node scripts/go-tui-acceptance.mjs",
    "predev:go": "node scripts/unhide-venv.mjs && npm run build:go",
    "dev:go": "node bin/liner.js",
    "predev:isolated": "node scripts/unhide-venv.mjs && npm run build:package",
    "dev:isolated": "node scripts/dev-isolated.mjs",
    "prepack": "npm run release:check && npm run build:package",
    "release:check": "uv run python ../../scripts/release-version.py --check",
    "release:check:publish": "uv run python ../../scripts/release-version.py --check --check-registry --registry-package linersh",
    "prepublishOnly": "npm run release:check:publish && npm run typecheck && npm test && npm run build:package",
    "predev": "node scripts/unhide-venv.mjs && npm run build:go",
    "dev": "node bin/liner.js",
    "predev:built": "node scripts/unhide-venv.mjs",
    "dev:built": "npm run build:package && node bin/liner.js",
    "start": "node bin/liner.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "linersh-darwin-arm64": "1.2.0",
    "linersh-darwin-x64": "1.2.0",
    "linersh-linux-arm64": "1.2.0",
    "linersh-linux-x64": "1.2.0",
    "linersh-win32-x64": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  }
}
