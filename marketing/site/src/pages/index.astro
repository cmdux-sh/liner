        <span class="flex items-center gap-2">/// free · MIT licensed · open source</span>
        <span class="flex items-center gap-2" style="color: var(--color-accent);">/// build reusable AI context</span>
        <span class="flex items-center gap-2">/// liner v{releaseVersion}</span>
