---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import CommandSnippet from "../components/CommandSnippet.astro";
import SiteHeader from "../components/SiteHeader.astro";
import releases from "../data/releases.json";

const releaseVersion = readFileSync(resolve(process.cwd(), "../../VERSION"), "utf8").trim();
const currentRelease = releases.find((entry) => entry.version === releaseVersion);
const releaseIsShipped = currentRelease?.published === true;
const renderedEntries = releases.map((entry) => ({
  ...entry,
  label: { number: entry.version, note: entry.note },
  isCurrent: entry.published && entry.version === releaseVersion,
  isCandidate: !entry.published,
}));

function inlineMarkdown(value: string) {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
}
---

<BaseLayout
  title="Liner Changelog"
  description="Changes to Liner's local CLI, terminal UI, source handling, and Project maintenance. Candidate work is labeled separately from shipped releases."
>
  <main id="content" tabindex="-1" class="changelog-page min-h-screen">
    <SiteHeader current="changelog" />

    <section class="changelog-hero">
      <div class="changelog-hero-inner">
        <p class="eyebrow eyebrow--accent">Changelog</p>
        <h1>Changes to the local research toolkit.</h1>
        <p>
          Follow changes to installation, source fetching, research review, and Project maintenance. Candidate entries stay labeled until the release ships.
        </p>

        <div class="release-strip" aria-label={`${releaseIsShipped ? "Current" : "Candidate"} release summary`}>
          <div>
            <span>{releaseIsShipped ? "Current" : "Candidate"}</span>
            <strong>{releaseVersion}</strong>
          </div>
          <div>
            <span>Install</span>
            <code>npx linersh</code>
          </div>
          <div>
            <span>Output</span>
            <strong>Research + AI instructions</strong>
          </div>
        </div>
      </div>
    </section>

    {releaseIsShipped && releaseVersion === "1.1.1" && (
    <section class="current-release-section" aria-label={`${releaseIsShipped ? "Current" : "Candidate"} ${releaseVersion} release spotlight`}>
      <div class="release-focus">
        <div class="release-focus-copy">
          <p class="eyebrow eyebrow--accent">{releaseIsShipped ? "Current release" : "Release candidate"} /// {releaseVersion}</p>
          <h2>Pick up interrupted research from its saved checkpoint.</h2>
          <p>
            Version {releaseVersion} preserves accepted work when a research step stops or a generated file fails validation. Reopen the Project to return to the right review or build step. Decisions from Improve Corpus survive restarts, and applied changes remain visible in the audit history.
          </p>
          <p>
            The optional Maintenance Adapter continues to route Project changes through the installed CLI. You can review the planned effects, approve changes when required, and inspect the saved Change Receipt.
          </p>
          <ul class="release-highlights">
            <li>
              <span>01</span>
              <p>Sources you already approved keep their IDs when Assembly adds evaluation details.</p>
            </li>
            <li>
              <span>02</span>
              <p>Interrupted research returns to the last saved review or build step.</p>
            </li>
            <li>
              <span>03</span>
              <p>Improve Corpus decisions survive restarts, with applied recommendations recorded in audit history.</p>
            </li>
          </ul>
        </div>

        <aside class="release-install" aria-label="Install command">
          <p class="eyebrow">Open Liner</p>
          <CommandSnippet command="npx linersh" label="Copy" />
          <p>
            Runs locally. AI-assisted research uses your configured Codex CLI or Claude Code runner and its account limits or charges. Compile and instruction-file creation make no model calls. The installed tool has no telemetry.
          </p>
        </aside>
      </div>
    </section>

    )}

    <section class="changelog-list-section">
      <div class="changelog-list-shell">
        <div class="changelog-section-intro">
          <p class="eyebrow eyebrow--accent">{releaseIsShipped ? "Shipped changes" : "Candidate and shipped changes"}</p>
          <h2>Release by release.</h2>
          <p>
            Candidate entries describe work awaiting publication. Historical entries describe the behavior shipped in each version.
          </p>
        </div>

        <div class="changelog-list">
          {renderedEntries.map((entry) => (
            <article class:list={["changelog-entry", { "is-current": entry.isCurrent || entry.isCandidate }]}>
              <div>
                <p>{entry.isCandidate ? "Candidate" : entry.isCurrent ? "Current" : "Version"}</p>
                <h2>
                  <span>{entry.label.number}</span>
                  {entry.label.note && <small>{entry.label.note}</small>}
                </h2>
                {entry.intro && <p class="entry-intro" set:html={inlineMarkdown(entry.intro)} />}
              </div>
              <ul class="changelog-items">
                {entry.changes.map((item) => (
                  <li>
                    {item.title && <strong set:html={inlineMarkdown(item.title)} />}
                    {item.body && <span set:html={inlineMarkdown(item.body)} />}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <style>
    .changelog-page {
      position: relative;
      overflow-x: clip;
      background:
        linear-gradient(90deg, transparent 7.95%, var(--color-line-soft) 8%, transparent 8.05%),
        linear-gradient(90deg, transparent 39.95%, var(--color-line-soft) 40%, transparent 40.05%),
        linear-gradient(90deg, transparent 91.95%, var(--color-line-soft) 92%, transparent 92.05%),
        var(--color-bg-workspace);
    }

    .changelog-hero,
    .changelog-list-section {
      padding-inline: 1.5rem;
    }

    .changelog-hero {
      border-bottom: 1px solid var(--color-line-medium);
      padding-block: clamp(4rem, 7vw, 5.5rem) clamp(2.5rem, 4vw, 3.5rem);
    }

    .changelog-hero-inner,
    .changelog-list-shell {
      max-width: 64rem;
      margin-inline: auto;
    }

    .changelog-hero .eyebrow {
      margin-bottom: 1rem;
    }

    .changelog-hero h1 {
      max-width: 21ch;
      color: var(--color-text-primary);
      font-size: clamp(2.35rem, 4.8vw, 4.65rem);
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: 0;
    }

    .changelog-hero p:not(.eyebrow) {
      max-width: 42rem;
      margin-top: 1.35rem;
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.75;
    }

    .release-strip {
      display: grid;
      gap: 1px;
      margin-top: clamp(2rem, 5vw, 3rem);
      border: 1px solid var(--color-line-medium);
      background: var(--color-line-medium);
    }

    .release-strip > div {
      display: grid;
      gap: 0.55rem;
      min-width: 0;
      padding: 1rem;
      background: var(--color-bg-workspace);
    }

    .release-strip span,
    .release-install .eyebrow {
      color: var(--color-text-dim);
    }

    .release-strip span {
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1.2;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .release-strip strong,
    .release-strip code {
      min-width: 0;
      color: var(--color-text-primary);
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.25;
    }

    .release-strip code {
      width: fit-content;
      border: 1px solid var(--color-line-medium);
      border-radius: 4px;
      padding: 0.14rem 0.38rem;
      background: var(--color-bg-deep);
      font-family: var(--font-mono);
      font-size: 0.95rem;
    }

    .current-release-section {
      border-bottom: 1px solid var(--color-line-medium);
      padding: clamp(2.75rem, 6vw, 4.5rem) 1.5rem;
    }

    .release-focus {
      display: grid;
      max-width: 64rem;
      margin-inline: auto;
      border: 1px solid var(--color-line-medium);
      background: var(--color-line-medium);
      gap: 1px;
    }

    .release-focus-copy,
    .release-install {
      min-width: 0;
      background: var(--color-bg-workspace);
      padding: clamp(1.25rem, 3vw, 2rem);
    }

    .release-focus h2 {
      max-width: 15ch;
      margin-top: 0.75rem;
      color: var(--color-text-primary);
      font-size: clamp(1.75rem, 3.2vw, 2.85rem);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: 0;
    }

    .release-focus-copy > p:not(.eyebrow) {
      max-width: 42rem;
      margin-top: 1.15rem;
      color: var(--color-text-secondary);
      font-size: 1rem;
      line-height: 1.75;
    }

    .release-focus code {
      border: 1px solid var(--color-line-medium);
      border-radius: 4px;
      padding: 0.1rem 0.28rem;
      background: var(--color-bg-deep);
      color: var(--color-text-primary);
      font-family: var(--font-mono);
      font-size: 0.9em;
    }

    .release-highlights {
      display: grid;
      gap: 1px;
      margin: clamp(1.5rem, 3vw, 2rem) 0 0;
      padding: 0;
      list-style: none;
      background: var(--color-line-medium);
    }

    .release-highlights li {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1rem;
      background: var(--color-bg-deep);
    }

    .release-highlights span {
      color: var(--color-accent);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      line-height: 1.6;
    }

    .release-highlights p {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .release-install {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .release-install p:last-child {
      max-width: 26rem;
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.9rem;
      line-height: 1.65;
    }

    .changelog-list-section {
      padding-block: clamp(2rem, 5vw, 3.5rem);
    }

    .changelog-section-intro {
      max-width: 42rem;
      margin-bottom: 1.5rem;
    }

    .changelog-section-intro h2 {
      margin-top: 0.75rem;
      color: var(--color-text-primary);
      font-size: clamp(1.45rem, 2.6vw, 2rem);
      font-weight: 400;
      line-height: 1.15;
      letter-spacing: 0;
    }

    .changelog-section-intro p:not(.eyebrow) {
      margin-top: 0.85rem;
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .changelog-list {
      border: 1px solid var(--color-line-medium);
      background: var(--color-line-medium);
    }

    .changelog-entry {
      display: grid;
      gap: 1.25rem;
      padding: clamp(1.15rem, 2vw, 1.65rem);
      background: var(--color-bg-workspace);
    }

    .changelog-entry.is-current {
      box-shadow: inset 3px 0 0 var(--color-accent);
    }

    .changelog-entry + .changelog-entry {
      margin-top: 1px;
    }

    .changelog-entry > div > p {
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1.2;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-accent);
    }

    .changelog-entry h2 {
      display: grid;
      gap: 0.4rem;
      margin-top: 0.45rem;
      color: var(--color-text-primary);
      font-size: clamp(1.35rem, 2vw, 1.75rem);
      font-weight: 400;
      line-height: 1.15;
      letter-spacing: 0;
    }

    .changelog-entry h2 small {
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      line-height: 1.25;
      text-transform: uppercase;
    }

    .entry-intro {
      margin-top: 0.9rem;
      color: var(--color-text-muted);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .changelog-items {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.8rem;
      max-width: 68ch;
    }

    .changelog-items li {
      position: relative;
      padding-left: 1.25rem;
      color: var(--color-text-secondary);
      font-size: 0.9375rem;
      line-height: 1.65;
    }

    .changelog-items li strong {
      display: block;
      margin-bottom: 0.2rem;
      color: var(--color-text-primary);
      font-weight: 500;
      line-height: 1.35;
    }

    .changelog-items li span {
      display: block;
    }

    .changelog-items li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.65rem;
      width: 0.35rem;
      height: 0.35rem;
      background: var(--color-accent);
    }

    .entry-intro code,
    .changelog-items code {
      border: 1px solid var(--color-line-medium);
      border-radius: 4px;
      padding: 0.1rem 0.28rem;
      background: var(--color-bg-deep);
      color: var(--color-text-primary);
      font-family: var(--font-mono);
      font-size: 0.9em;
    }

    .changelog-items strong {
      color: var(--color-text-primary);
      font-weight: 500;
    }

    @media (min-width: 48rem) {
      .changelog-hero,
      .current-release-section,
      .changelog-list-section {
        padding-inline: 3rem;
      }

      .release-strip {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .release-focus {
        grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
      }

      .changelog-entry {
        grid-template-columns: 10rem minmax(0, 1fr);
      }
    }

    @media (min-width: 64rem) {
      .changelog-hero,
      .current-release-section,
      .changelog-list-section {
        padding-inline: 5rem;
      }
    }
  </style>
</BaseLayout>
