---
import Icon from "./Icon.astro";

interface Props {
  current?: "home" | "docs" | "changelog";
  className?: string;
}

const { current = "home", className = "" } = Astro.props;
const hasCenter = Astro.slots.has("center");

const links = [
  { href: "/docs/", label: "Docs", key: "docs" },
  { href: "/changelog/", label: "Changelog", key: "changelog" },
] as const;
---

<header
  class:list={["site-header", { "site-header--has-center": hasCenter }, className]}
  style="background: linear-gradient(to bottom, rgb(15 15 15 / 0.94), rgb(15 15 15 / 0.68) 76%, rgb(15 15 15 / 0));"
>
  <a href="/" class="brand-mark" aria-label="Liner home">
    <span class="record-dot" aria-hidden="true"></span>
    <img src="/liner-logo.svg" alt="Liner" />
  </a>

  {hasCenter && (
    <div class="site-header-center">
      <slot name="center" />
    </div>
  )}

  <nav class="site-nav" aria-label="Primary">
    {links.map((link) => (
      <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
        {link.label}
      </a>
    ))}
    <a href="https://github.com/cmdux-sh/liner" class="github-link">
      GitHub
      <Icon name="arrow-up-right" size={12} strokeWidth={2} aria-hidden="true" />
    </a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5rem;
    width: 100%;
    padding: 0 1.5rem;
    border-bottom: 1px solid var(--color-line-medium);
    backdrop-filter: blur(10px);
  }

  .site-header--has-center {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(14rem, 28rem) minmax(10rem, 1fr);
    align-items: center;
  }

  .site-header.site-header--hero {
    border-bottom: 0;
  }

  .brand-mark,
  .site-header-center,
  .site-nav,
  .github-link {
    display: flex;
    align-items: center;
  }

  .brand-mark {
    gap: 0.75rem;
    min-width: 0;
    justify-self: start;
  }

  .site-header-center {
    min-width: 0;
    justify-content: center;
  }

  .site-header-center :global(site-search) {
    width: 100%;
  }

  .record-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    flex: 0 0 auto;
    background: var(--color-accent);
    box-shadow: 0 0 0 0 rgb(255 69 0 / 0.65);
    animation: record-pulse 1.45s ease-out infinite;
  }

  @keyframes record-pulse {
    0% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgb(255 69 0 / 0.65);
    }

    70% {
      opacity: 0.45;
      box-shadow: 0 0 0 7px rgb(255 69 0 / 0);
    }

    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgb(255 69 0 / 0);
    }
  }

  .brand-mark img {
    height: 2rem;
    width: auto;
    object-fit: contain;
    opacity: 0.95;
    filter: invert(1);
  }

  .site-nav {
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    justify-self: end;
  }

  .site-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 160ms ease-out;
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"],
  .github-link {
    color: var(--color-accent);
  }

  .github-link {
    gap: 0.375rem;
  }

  @media (min-width: 48rem) {
    .site-header {
      min-height: 6rem;
      padding-inline: 3rem;
    }

    .brand-mark img {
      height: 2.75rem;
    }
  }

  @media (min-width: 64rem) {
    .site-header {
      padding-inline: 5rem;
    }
  }

  @media (max-width: 42rem) {
    .site-header {
      padding-inline: 1.5rem;
    }

    .site-header--has-center {
      grid-template-columns: auto minmax(2.75rem, 11rem);
      justify-content: space-between;
      gap: 0.75rem;
    }

    .site-header--has-center .site-nav {
      display: none;
    }

    .site-nav {
      gap: 1rem;
      font-size: 11px;
      letter-spacing: 0.08em;
    }

    .github-link {
      display: none;
    }
  }
</style>
