---
import Icon from "./Icon.astro";

interface Props {
  command: string;
  prompt?: string;
  label?: string;
  accessibleLabel?: string;
  tone?: "dark" | "accent";
}

const { command, prompt = "$", label = "Copy", accessibleLabel, tone = "dark" } = Astro.props;
const lines = command.split("\n");
const isMultiline = lines.length > 1;
---

<div class:list={["command-snippet", "not-content", `command-snippet--${tone}`, { "is-multiline": isMultiline }]}>
  <pre tabindex="0" aria-label="Command to run"><code>{lines.map((line, index) => <span class="command-line"><span class="command-prompt" aria-hidden="true">{index === 0 ? prompt : ""}</span><span>{line}</span></span>)}</code></pre>
  <button
    data-pagefind-ignore
    data-copy-button
    type="button"
    class="copy-install-cmd docs-copy-command"
    data-command={command}
    aria-label={accessibleLabel ?? `Copy command: ${command.replace(/\s+/g, " ")}`}
  >
    <span data-copy-icon>
      <Icon name="copy" size={13} strokeWidth={2} aria-hidden="true" />
      {label}
    </span>
    <span data-copy-done>
      <Icon name="check" size={13} strokeWidth={2} aria-hidden="true" />
      Copied
    </span>
  </button>
  <span class="copy-status" role="status" data-pagefind-ignore></span>
</div>

<script>
  import { bindCommandCopy } from "../scripts/copy-command";
  bindCommandCopy();
</script>

<style>
  .command-snippet {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    width: fit-content;
    max-width: 100%;
    min-block-size: var(--control-size);
    margin: 0.85rem 0 1.1rem;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    background: var(--color-bg-deep);
    border-color: var(--color-control-border);
  }

  .command-snippet:has(:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 4px; }

  .command-snippet.is-multiline {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
  }

  .command-snippet pre {
    min-width: 0;
    flex: 1;
    margin: 0;
    overflow-x: auto;
    padding: 0;
    background: transparent;
  }

  .command-snippet pre code {
    display: grid;
    gap: 0.16rem;
    margin: 0;
    border: 0;
    border-radius: 0;
    padding: 0.5rem 0.75rem;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .command-line {
    display: grid;
    grid-template-columns: 1.15rem minmax(0, 1fr);
    align-items: center;
    white-space: pre;
  }

  .command-prompt {
    color: var(--color-text-dimmer);
  }

  .docs-copy-command {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 5.75rem;
    flex: none;
    border: 0;
    border-inline-start: 1px solid var(--color-line-medium);
    background: var(--color-control-fill);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .docs-copy-command:hover { background: var(--color-control-hover); }
  }
  .docs-copy-command:active { background: var(--color-control-hover); }
  .docs-copy-command:disabled { cursor: wait; }
  .copy-status {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .command-snippet:has([data-copy-state="error"]) { flex-wrap: wrap; }
  .command-snippet:has([data-copy-state="error"]) .copy-status {
    position: static;
    inline-size: 100%;
    block-size: auto;
    padding: var(--space-control);
    clip-path: none;
    white-space: normal;
    color: var(--color-text-secondary);
    font-size: var(--type-body);
  }

  .docs-copy-command span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .docs-copy-command [data-copy-done] {
    display: none;
    color: var(--color-accent-secondary);
  }

  .command-snippet--accent {
    border-color: var(--color-control-border);
    background: var(--color-bg-deep);
  }

  @media (max-width: 36rem) {
    .command-snippet pre code {
      font-size: 0.875rem;
    }
  }
</style>
