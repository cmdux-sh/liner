---
interface TreeItem {
  name: string;
  kind?: "file" | "dir";
  depth?: number;
  accent?: boolean;
}

interface Props {
  root: string;
  items: TreeItem[];
  label?: string;
}

const { root, items, label = "Project Folder" } = Astro.props;
---

<div class="file-tree">
  <div class="file-tree__header">
    <span>{label}</span>
    <span>{root}</span>
  </div>
  <div class="file-tree__body" role="list" aria-label={`${root} file tree`}>
    {items.map((item) => (
      <div
        class:list={["file-tree__row", { "is-dir": item.kind === "dir", "is-accent": item.accent }]}
        role="listitem"
        style={`--depth: ${item.depth ?? 0}`}
      >
        <span class="file-tree__branch" aria-hidden="true"></span>
        <span>{item.name}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .file-tree {
    width: min(100%, 46rem);
    margin: 1rem 0 1.35rem;
    border: 1px solid var(--color-line-medium);
    background: var(--color-bg-deep);
  }

  .file-tree__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line-medium);
    padding: 0.75rem 0.9rem;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .file-tree__header span:last-child {
    color: var(--color-accent);
    text-transform: none;
  }

  .file-tree__body {
    display: grid;
    gap: 0.28rem;
    padding: 0.9rem;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .file-tree__row {
    display: grid;
    grid-template-columns: calc(var(--depth) * 1.25rem) minmax(0, 1fr);
    align-items: baseline;
    min-width: 0;
  }

  .file-tree__row span:last-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .file-tree__branch::before {
    content: "";
  }

  .file-tree__row.is-dir {
    color: var(--color-text-primary);
  }

  .file-tree__row.is-accent {
    color: var(--color-accent);
  }

  @media (max-width: 36rem) {
    .file-tree__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
