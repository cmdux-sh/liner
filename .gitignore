__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
uv.lock
*.db
.DS_Store

# Node / TUI build artifacts
node_modules/
packages/tui/bin/liner-tui
packages/tui/bin/liner-tui.exe

# Generated npm platform binary packages (large PyInstaller outputs).
packages/platform/

# Per-curator mixtape data — not committed; mixtapes are personal projects
# that contain the curator's URLs, notes, fetched bodies, and agent run
# transcripts (.liner-runs/ JSONL has raw model traffic). If we ever want
# example mixtapes as fixtures, add them under a designated tests/fixtures/
# path that's explicitly tracked.
mixtapes/
packages/tui/mixtapes/
process.json
.liner-runs/
.liner-progress.json
.liner-gates.json

# Local-only build tarballs from `npm pack` (not source).
*.tgz

# Skill bundle copied into the TUI package at prepack time. The tracked source
# of truth is docs/curation-skill/; this copy is for npm-publish layout only.
packages/tui/cli-update-docs/
packages/tui/maintenance-skill/

# Local-only documents kept outside this repo (handoffs, planning,
# old PRDs). Path is for documentation; the directory lives outside
# the repo so this rule is just a safety net.
liner-private-docs/

# Worktrees (workspace state, not source)
.claude/worktrees/
.vercel
